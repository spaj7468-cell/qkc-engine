{
  "name": "qkc-engine",
  "version": "1.2.0",
  "description": "Dependency-free JavaScript quiz engine: seeded test assembly, scoring, validation and an embeddable QKC.init() widget (normal/exam/sprint, bw/light/dark, RU/EN, onAnswer/onFinish events). Zero dependencies, UMD + ESM, MIT.",
  "main": "dist/qkc-engine.js",
  "module": "dist/qkc-engine.mjs",
  "exports": {
    ".": {
      "import": "./dist/qkc-engine.mjs",
      "require": "./dist/qkc-engine.js",
      "default": "./dist/qkc-engine.js"
    }
  },
  "files": [
    "dist",
    "src",
    "engine.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node test/test.mjs && node test/dom.mjs"
  },
  "keywords": [
    "quiz",
    "test",
    "exam",
    "education",
    "edtech",
    "engine",
    "question-bank",
    "assessment",
    "zero-dependency",
    "widget",
    "embed",
    "vanilla-js"
  ],
  "author": "OuRi Corp <juravlev.aleksandr2020@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spaj7468-cell/qkc-engine.git"
  },
  "homepage": "https://github.com/spaj7468-cell/qkc-engine#readme",
  "bugs": "https://github.com/spaj7468-cell/qkc-engine/issues",
  "unpkg": "dist/qkc-engine.js",
  "jsdelivr": "dist/qkc-engine.js"
}